# ==========================================
# GITIGNORE CHO DỰ ÁN DOCKER WORDPRESS CMS
# ==========================================

# Môi trường và cấu hình bảo mật cục bộ
.env
wp-config.php

# File dump database tạm thời (giữ lại file seed khởi tạo cho cả nhóm)
docker/db-init/*.sql
docker/db-init/*.sql.gz
!docker/db-init/.gitkeep
!docker/db-init/README.md
!docker/db-init/init.sql

# File tạm và logs
*.log
error_log
debug.log
.alcache/
.snapshots/
.output/

# Hệ điều hành
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE và Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

