# ==========================================
# CẤU HÌNH DOCKER COMPOSE CHO GROUP-A_CMS
# Mỗi thành viên copy file này thành .env:
# cp .env.example .env (hoặc copy .env.example .env trên Windows CMD)
# ==========================================

# Tên dự án Docker (giúp phân biệt container với các project khác)
COMPOSE_PROJECT_NAME=group_a_cms

# Cổng ánh xạ ra máy chủ (Host Ports)
# Mặc định cổng 80 cho domain http://wordpress.local
WORDPRESS_PORT=80
PHPMYADMIN_PORT=8089
DB_PORT=3308

# Cấu hình Cơ sở dữ liệu MySQL
DB_NAME=group_a_db
DB_USER=group_a_user
DB_PASSWORD=group_a_pass
DB_ROOT_PASSWORD=group_a_root_pass

# Cấu hình WordPress
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=1

